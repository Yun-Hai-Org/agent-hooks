#!/usr/bin/env bash
# Kind smoke test template — copy to scripts/kind-smoke.sh and customize.
# Requires: podman (or docker), kind, kubectl
set -euo pipefail

IMAGE_NAME="${IMAGE_NAME:-app:kind-smoke}"
CLUSTER_NAME="${KIND_CLUSTER_NAME:-kind-smoke}"
CONTAINERFILE="${CONTAINERFILE:-Dockerfile}"
K8S_DIR="${K8S_DIR:-k8s}"

cleanup() {
  kind delete cluster --name "${CLUSTER_NAME}" 2>/dev/null || true
}
trap cleanup EXIT

if command -v podman >/dev/null 2>&1; then
  RUNTIME=podman
elif command -v docker >/dev/null 2>&1; then
  RUNTIME=docker
else
  echo "error: podman or docker required" >&2
  exit 1
fi

"${RUNTIME}" build -f "${CONTAINERFILE}" -t "${IMAGE_NAME}" .
kind create cluster --name "${CLUSTER_NAME}"
kind load "${RUNTIME}-image" "${IMAGE_NAME}" --name "${CLUSTER_NAME}"
kubectl apply -f "${K8S_DIR}/"
kubectl rollout status deployment --all --timeout=120s
kubectl get pods -A

echo "Kind smoke passed"
