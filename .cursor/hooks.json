{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "HOOK_PLATFORM=cursor bun .claude/hooks/resolve-hook-path.js block-dangerous-commands.js"
      },
      {
        "command": "HOOK_PLATFORM=cursor bun .claude/hooks/resolve-hook-path.js commit-gate.js"
      },
      {
        "command": "HOOK_PLATFORM=cursor bun .claude/hooks/resolve-hook-path.js merge-gate.js"
      },
      {
        "command": "HOOK_PLATFORM=cursor bun .claude/hooks/resolve-hook-path.js push-gate.js"
      }
    ],
    "beforeReadFile": [
      {
        "command": "HOOK_PLATFORM=cursor bun .claude/hooks/resolve-hook-path.js protect-secrets.js"
      }
    ],
    "afterFileEdit": [
      {
        "command": "HOOK_PLATFORM=cursor bun .claude/hooks/resolve-hook-path.js auto-stage.js"
      }
    ],
    "stop": [
      {
        "command": "HOOK_PLATFORM=cursor bun .claude/hooks/resolve-hook-path.js auto-commit.js",
        "loop_limit": 8
      },
      {
        "command": "HOOK_PLATFORM=cursor bun .claude/hooks/resolve-hook-path.js gate-retry-stop.js",
        "loop_limit": 8
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "HOOK_PLATFORM=cursor bun .claude/hooks/resolve-hook-path.js user-prompt-filter.js"
      }
    ]
  }
}
