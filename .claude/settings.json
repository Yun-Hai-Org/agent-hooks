{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/block-dangerous-commands.js",
            "statusMessage": "检查危险命令和工具限制..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/branch-gate.js",
            "statusMessage": "检查分支保护（master/main 写入限制）..."
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/protect-secrets.js",
            "statusMessage": "检查敏感文件和内容..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/commit-gate.js",
            "statusMessage": "检查提交规范..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/merge-gate.js",
            "statusMessage": "检查合并操作..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/post-write-lint.js",
            "statusMessage": "执行代码质量检查..."
          },
          {
            "type": "command",
            "command": "bun .claude/hooks/auto-stage.js",
            "statusMessage": "自动暂存修改文件..."
          }
        ]
      }
    ]
  }
}
