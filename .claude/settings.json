{
  "permissions": {
    "allow": ["Bash(git add *)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.ts session-start.ts",
            "statusMessage": "检查工具健康状态..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.ts user-prompt-filter.ts",
            "statusMessage": "扫描提示词中的敏感信息..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.ts block-dangerous-commands.ts",
            "statusMessage": "检查危险命令和工具限制..."
          },
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.ts branch-delete-gate.ts",
            "statusMessage": "检查未合并分支/worktree 删除..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.ts branch-gate.ts",
            "statusMessage": "检查分支保护（master/main 写入限制）..."
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.ts protect-secrets.ts",
            "statusMessage": "检查敏感文件和内容..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.ts notification-hook.ts",
            "statusMessage": "发送安全事件通知..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_PLATFORM=claude bun .claude/hooks/resolve-hook-path.ts format-on-write.ts",
            "statusMessage": "写入后自动格式化..."
          },
          {
            "type": "command",
            "command": "HOOK_PLATFORM=claude bun .claude/hooks/resolve-hook-path.ts auto-stage.ts",
            "statusMessage": "自动暂存修改文件..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_PLATFORM=claude bun .claude/hooks/resolve-hook-path.ts auto-commit.ts",
            "statusMessage": "自动提交暂存变更..."
          },
          {
            "type": "command",
            "command": "HOOK_PLATFORM=claude bun .claude/hooks/resolve-hook-path.ts gate-retry-stop.ts",
            "statusMessage": "push/merge 质量门修复循环..."
          }
        ]
      }
    ]
  }
}
