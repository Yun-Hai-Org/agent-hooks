{
  "permissions": {
    "allow": [
      "Bash(git add *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.js session-start.js",
            "statusMessage": "检查工具健康状态..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.js user-prompt-filter.js",
            "statusMessage": "扫描提示词中的敏感信息..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.js block-dangerous-commands.js",
            "statusMessage": "检查危险命令和工具限制..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.js branch-gate.js",
            "statusMessage": "检查分支保护（master/main 写入限制）..."
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.js protect-secrets.js",
            "statusMessage": "检查敏感文件和内容..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.js commit-gate.js",
            "statusMessage": "检查提交规范..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_PLATFORM=claude bun .claude/hooks/resolve-hook-path.js merge-gate.js",
            "statusMessage": "检查合并操作..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_PLATFORM=claude bun .claude/hooks/resolve-hook-path.js push-gate.js",
            "statusMessage": "检查推送质量门..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/resolve-hook-path.js notification-hook.js",
            "statusMessage": "发送安全事件通知..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_PLATFORM=claude bun .claude/hooks/resolve-hook-path.js auto-stage.js",
            "statusMessage": "自动暂存修改文件..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_PLATFORM=claude bun .claude/hooks/resolve-hook-path.js auto-commit.js",
            "statusMessage": "自动提交暂存变更..."
          },
          {
            "type": "command",
            "command": "HOOK_PLATFORM=claude bun .claude/hooks/resolve-hook-path.js gate-retry-stop.js",
            "statusMessage": "push/merge 质量门修复循环..."
          }
        ]
      }
    ]
  }
}
